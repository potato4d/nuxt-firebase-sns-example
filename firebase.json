{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "/.*",
        "destination": "https://github.com/potato4d/nuxt-firebase-sns-example",
        "type": 301
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
